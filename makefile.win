# Project: v3.0.1
# Makefile created by Red Panda C++ 3.3.3147

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-Wl,--stack,12582912" "-mwindows" "-lgraphics" "-luuid" "-lmsimg32" "-lgdi32" "-limm32" "-lole32" "-loleaut32" "-lwinmm" "-lgdiplus"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-g3" "-O2" "-pipe" "-Wall" "-lcomdlg32" "-D_DEBUG"
CFLAGS   = $(INCS) "-g3" "-O2" "-pipe" "-Wall" "-lcomdlg32" "-D_DEBUG"
WINDRESFLAGS = 
RES      = v3_private.res
OBJ      = main.o $(RES)
BIN      = v3.0.1.exe
LINKOBJ  = "main.o" "v3_private.res"
CLEANOBJ = "main.o" "v3_private.res" "v3.0.1.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

v3.0.1.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "v3.0.1.exe" $(LIBS)

main.o: main.cpp
	$(CXX) -c "main.cpp" -o "main.o" $(CXXFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

v3_private.res: v3_private.rc 
	$(WINDRES) -i "v3_private.rc" --input-format=rc -o "v3_private.res" -O coff $(WINDRESFLAGS) 

